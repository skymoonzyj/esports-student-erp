{
	# Certificate issuance is handled by the DNSHE DNS-01 renewal job.  Do not
	# let Caddy fall back to HTTP-01/TLS-ALPN-01 (the NAS intentionally does not
	# publish ports 80 or 443).
	auto_https off
}

skymoonzyj.l.cd {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/privkey.pem
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy proxy:8080
}
